# Free default: Google Gemini
LLM_PROVIDER=gemini
GEMINI_API_KEY=AIza...

# Optional model override (default: gemini-2.0-flash)
# OPENAI_MODEL=gemini-2.0-flash

# --- Or use local Ollama (fully free, no cloud key) ---
# LLM_PROVIDER=ollama
# OPENAI_MODEL=llama3.2

# --- Or paid OpenAI ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4.1-mini
